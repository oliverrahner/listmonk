[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Database.
[db]
host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""

# Incoming mail processing (optional).
# Allows receiving emails and forwarding them to list subscribers.
# [incoming]
# enabled = false

# Configure POP3 mailboxes to scan for incoming emails.
# [[incoming.mailboxes]]
# enabled = false
# uuid = "unique-mailbox-id"
# type = "pop"
# host = "mail.example.com"
# port = 995
# auth_protocol = "plain"  # Options: plain, none
# username = "lists@example.com"
# password = "password"
# tls_enabled = true
# tls_skip_verify = false
# scan_interval = "5m"  # How often to check for new emails (e.g., "5m", "1m", "30s")

